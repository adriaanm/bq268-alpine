#!/sbin/openrc-run

# qmi-proxy: persistent QMI multiplexer.
#
# Holds one long-lived QmiDevice against msmipc://0 and multiplexes all
# qmicli clients through it (clients opt in via `qmicli -p`). Libqmi
# owns indication draining for every subscribed client, so stale
# subscriptions from short-lived qmicli invocations no longer pile up in
# the kernel msm_ipc_router delivery queue (see
# `send_filled_buffers_to_user: Send Failed -3` in dmesg).
#
# Listens on the abstract unix socket "qmi-proxy" — no filesystem path.
# `--no-exit` keeps the daemon alive even when no clients are
# connected, so we don't pay reconnect/open cost on every qmicli call.

description="QMI proxy (multiplexer for msmipc://0)"

# supervise-daemon owns the pid and respawns the proxy if it dies. The old
# command_background+pidfile pattern recorded the WRAPPER's pid, not the
# daemon's, so `rc-status` called a perfectly healthy proxy "crashed" — and
# with a parallel runlevel a second start could be attempted behind that lie,
# which the survivor logged as "Error binding to address: Address in use".
# Everything QMI (the modem's readiness gate, cell-data, lpac) goes through
# this socket, so it must be both up and honestly reported.
supervisor=supervise-daemon
command="/usr/libexec/qmi-proxy"
command_args="--no-exit"
respawn_delay=5
respawn_max=0
output_log="/var/log/qmi-proxy.log"
error_log="/var/log/qmi-proxy.log"

depend() {
    need rmt-storage
    before modem
    # We do NOT "need modem" — the proxy is a plain unix-socket
    # multiplexer and can (and must) start before Q6 is up, so the
    # modem init script can route its `dms-set-operating-mode=online`
    # readiness probe through us (qmicli -p) and not leak a NAS
    # indication subscription per retry into msm_ipc_router.
}

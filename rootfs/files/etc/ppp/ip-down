#!/bin/sh
#
# This script is run by pppd after the connection has ended.
#
# Undo ip-up's resolver edit: put back whatever /etc/resolv.conf held before
# the data call (normally wifi's DHCP-written file).

SAVED=/run/resolv.conf.pre-ppp

if [ -f "$SAVED" ]; then
    mv "$SAVED" /etc/resolv.conf
    # the saved copy carries the mode it was saved with, and a single 0600
    # file here is self-perpetuating across boots — see the note in ip-up.
    chmod 644 /etc/resolv.conf
    logger -t ppp-ip-down "restored pre-ppp resolv.conf"
fi
